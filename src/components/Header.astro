---
import HeaderMenu from "./HeaderMenu.astro";
import Favicon from "../images/favicon.svg";
import MotionLogo from "../images/motion.svg";
import SketchpadLogo from "../images/sketchpad.svg";

export interface Props {
    color?: string;
}

const { color } = Astro.props;
---

<header style={{ color }}>
    <main>
        <a href="/" class="logo" title="Homepage">
            <Favicon width={32} height={32} />
            <span>Nahara's Organization</span>
        </a>
        <HeaderMenu href="/software" label="Software">
            <div class="multiple-column-menu">
                <div>
                    <h1>All software</h1>
                    <a href="https://github.com/Nahara-OSS/motion" target="_blank">
                        <MotionLogo class="icon" />
                        <div class="content">
                            <h1>Motion</h1>
                            <p>2D motion graphics editor</p>
                        </div>
                    </a>
                    <a href="https://codeberg.org/nahara/sketchpad" target="_blank">
                        <SketchpadLogo class="icon" />
                        <div class="content">
                            <h1>Sketchpad</h1>
                            <p>Companion sketching app</p>
                        </div>
                    </a>
                </div>
            </div>
        </HeaderMenu>
        <HeaderMenu href="/blog" label="Blog" />
        <HeaderMenu href="/about" label="About" />
    </main>
</header>

<style>
    header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        background-color: transparent;
        border-bottom: 0.1em solid transparent;
        animation-timeline: scroll();
        animation-range: 4em 8em;
        animation-fill-mode: forwards;
        animation-name: header-color;
        animation-timing-function: linear;
        z-index: 1;

        > main {
            padding: 1em;
            max-width: 1600px;
            margin-inline: auto;
            display: flex;
            flex-direction: row;
            gap: 0.2em;
            box-sizing: border-box;

            > .logo {
                margin-inline-end: 0.5em;
                gap: 1em;
                display: flex;
                flex-direction: row;
                align-items: center;
                text-decoration: none;
                overflow: hidden;
                width: 222px;
                animation-timeline: scroll();
                animation-range: 4em 8em;
                animation-fill-mode: forwards;
                animation-name: logo;
                animation-timing-function: cubic-bezier(1, 0, 0.5, 1);

                > svg {
                    fill: currentColor;
                    flex-shrink: 0;
                }

                > span {
                    font-weight: 600;
                    white-space: nowrap;
                    width: 0;
                    flex-grow: 1;
                }
            }
        }
    }

    .multiple-column-menu {
        display: flex;
        flex-direction: row;

        > div {
            display: flex;
            flex-direction: column;
            gap: 0.2em;
            min-width: 300px;
            padding: 1em;

            > h1 {
                font-size: 1em;
                font-weight: 600;
                color: var(--theme-muted);
                margin: 0;
                margin-block-end: 1em;
            }

            > a {
                text-decoration: none;
                display: flex;
                flex-direction: row;
                gap: 0.5em;
                align-items: center;
                border: 0.1em solid transparent;
                background-color: transparent;

                &:hover {
                    border-color: var(--theme-outline-md);
                    background-color: var(--theme-control-md);
                }

                &:active {
                    border-color: var(--theme-outline-hi);
                    background-color: var(--theme-control-hi);
                }

                > .icon {
                    aspect-ratio: 1 / 1;
                    height: 3em;
                }

                > .content {
                    line-height: 1.2;
                    margin-inline-end: 0.6em;

                    > h1,
                    > p {
                        font-size: 1em;
                        margin: 0;
                        font-weight: 400;
                    }

                    > p {
                        color: var(--theme-muted);
                    }
                }
            }
        }
    }

    @keyframes header-color {
        from {
            background-color: transparent;
            border-color: transparent;
        }

        to {
            background-color: var(--theme-container-md);
            border-color: var(--theme-outline-lo);
            color: inherit;
        }
    }

    @keyframes logo {
        from {
            width: 222px;
        }

        to {
            width: 32px;
        }
    }

    @media print {
        header {
            display: none;
        }
    }
</style>
