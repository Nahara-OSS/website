---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const posts = await getCollection("blog");
const publishedPosts = posts
    .filter((post) => post.data.publishedOn != null)
    .sort((a, b) => a.data.publishedOn!.getTime() - b.data.publishedOn!.getTime());
---

<Layout>
    <div class="listing">
        <header>
            <h1>Blogs</h1>
            <p>The layout is scuffed right now, but here are the blog posts</p>
        </header>
        <main>
            {publishedPosts.map((post) => <a href={`/blog/${post.id}`}>{post.data.title}</a>)}
        </main>
    </div>
</Layout>

<style>
    .listing {
        margin-inline: auto;
        margin-block-start: 8em;
        margin-block-end: 1em;
        max-width: 1000px;
        padding: 2em;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;

        > header {
            display: flex;
            flex-direction: column;
            gap: 1em;
            padding-block-end: 3em;
            border-bottom: 0.1em solid var(--theme-outline-lo);

            > h1 {
                font-size: 2.5em;
                margin: 0;
            }

            > p {
                font-style: italic;
                margin: 0;
            }
        }

        > main {
            display: flex;
            flex-direction: column;
            padding-block-start: 2em;
            gap: 0.5em;
        }
    }
</style>
