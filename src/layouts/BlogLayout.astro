---
import type { MarkdownHeading } from "astro";
import Layout from "./Layout.astro";

export interface Props {
    frontmatter: FrontMatter;
    headings: MarkdownHeading[];
}

interface FrontMatter {
    title: string;
    author: string;
    brief: string;
    tags?: string[];
    publishedOn?: string;
}

const {
    headings,
    frontmatter: { title, author, brief, tags, publishedOn: publishedOnString },
} = Astro.props;

const publishedOn = publishedOnString != null ? new Date(publishedOnString) : null;
const locale = new Intl.Locale("en-US");
const timeFormatter = new Intl.DateTimeFormat(locale, { dateStyle: "long", timeStyle: "long" });
---

<Layout title={title} description={brief} keywords={tags?.join(", ")}>
    <div class="table-of-content">
        <h1>Table of content</h1>
        {
            headings.map(({ text, slug, depth }) => (
                <a href={"#" + slug} style={`--depth: ${depth}`}>
                    {text}
                </a>
            ))
        }
    </div>
    <article>
        <header>
            <h1>{title}</h1>
            <p>{brief}</p>
            <div class="meta">
                <span class="author">{author}</span>
                <span>&mid;</span>
                <span class="publish-date">{publishedOn != null ? timeFormatter.format(publishedOn) : "Draft"}</span>
            </div>
        </header>
        <main>
            <slot />
        </main>
    </article>
</Layout>

<style>
    article {
        margin-inline: auto;
        margin-block-start: 8em;
        margin-block-end: 1em;
        max-width: 1000px;
        padding: 2em;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;

        > header {
            display: flex;
            flex-direction: column;
            gap: 1em;
            padding-block-end: 3em;
            border-bottom: 0.1em solid var(--theme-outline-lo);

            > h1 {
                font-size: 2.5em;
                margin: 0;
            }

            > p {
                font-style: italic;
                margin: 0;
            }

            > .meta {
                display: flex;
                flex-direction: row;
                gap: 0.5em;
                color: var(--theme-muted);
            }
        }

        > main {
            line-height: 1.4;
            text-align: justify;
            counter-reset: heading;
            padding-block-start: 2em;

            h2,
            h3 {
                margin-block: 1em;
                scroll-margin-block-start: 3em;

                &::before {
                    color: var(--theme-muted);
                    font-weight: 500;
                    print-color-adjust: exact;
                    font-feature-settings: "zero", "tnum";
                }
            }

            h2 {
                font-size: 2em;
                counter-reset: subheading 0;
                counter-increment: heading 1;

                &::before {
                    content: counter(heading) ". ";
                }
            }

            h3 {
                font-size: 1.4em;
                counter-increment: subheading 1;

                &::before {
                    content: counter(heading) "." counter(subheading) ". ";
                }
            }

            p {
                margin-block: 1em;
            }

            ul,
            ol {
                margin-block: 1em;
            }

            blockquote {
                margin: 0;
                display: flow-root;
                padding-inline-start: 2em;
                position: relative;
                color: var(--theme-muted);

                &::before {
                    content: "";
                    position: absolute;
                    width: 0.5em;
                    height: 100%;
                    left: 0;
                    top: 0;
                    background-color: var(--theme-outline-lo);
                }
            }

            pre {
                padding-block: 1em;
                padding-inline: 2em;
            }

            svg,
            img {
                position: relative;
                width: calc(100% - 8em);
                min-width: 340px;
                height: auto;
                margin-inline: auto;
                margin-block: 2em;
                box-sizing: border-box;
                border: 0.1em solid var(--theme-outline-lo);
                display: block;
            }

            svg.flowchart {
                background-color: #ffffff;
            }
        }
    }

    .table-of-content {
        position: fixed;
        display: flex;
        flex-direction: column;
        top: 12em;
        right: 2em;
        width: 200px;
        gap: 0.5em;

        > h1 {
            margin: 0;
            font-size: 1em;
            margin-block-end: 0.5em;
            font-weight: 600;
            color: var(--theme-muted);
        }

        > a {
            text-decoration: none;
            margin-inline-start: calc((var(--depth) - 2) * 1.5em);
            line-height: 1.2;
        }
    }

    @media (max-width: 1600px) {
        .table-of-content {
            display: none;
        }
    }

    @media print {
        article {
            margin-block-start: 2em;
        }
    }
</style>
